# Backend API URL (your Render backend)
BACKEND_API_URL=https://regency-gardens-1.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://regency-gardens-1.onrender.com/api/v1

# JWT Secrets — must match the backend exactly
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Environment
NODE_ENV=production
